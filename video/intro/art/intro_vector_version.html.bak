      tl.fromTo("#s4-mid", { x: 0 }, { x: -700, duration: 8.4, ease: "none" }, 37.6);
      tl.fromTo("#s4-road", { x: 0 }, { x: -960, duration: 8.4, ease: "none" }, 37.6);
      runners.forEach(([id], i) => {
        tl.fromTo(`#${id}`, { x: -1400 }, { x: 0, duration: 1.4, ease: "power2.out" }, 37.8 + i * 0.12);
        tl.fromTo(`#${id}-rig`, { y: 0, rotation: 8 }, { y: -26, rotation: 8, duration: 0.16, yoyo: true, repeat: 49, ease: "sine.out", svgOrigin: "0 0" }, 37.6 + i * 0.05);
        tl.fromTo(`#${id}-fl`, { y: 0, x: 0 }, { y: -20, x: 16, duration: 0.16, yoyo: true, repeat: 49, ease: "sine.inOut" }, 37.6);
        tl.fromTo(`#${id}-fr`, { y: -20, x: 16 }, { y: 0, x: 0, duration: 0.16, yoyo: true, repeat: 49, ease: "sine.inOut" }, 37.6);
        tl.fromTo(`#${id}-armR`, { rotation: -30 }, { rotation: 30, duration: 0.32, yoyo: true, repeat: 24, ease: "sine.inOut", svgOrigin: "74 -96" }, 37.6);
        tl.fromTo(`#${id}-armL`, { rotation: 30 }, { rotation: -30, duration: 0.32, yoyo: true, repeat: 24, ease: "sine.inOut", svgOrigin: "-74 -96" }, 37.6);
      });
      letters("s4-title", s4TitleN, 41.0);
      tl.fromTo("#s4-title", { scale: 1 }, { scale: 1.05, duration: 0.8, yoyo: true, repeat: 3, ease: "sine.inOut" }, 42.0);
      tl.fromTo("#s4-sub", { opacity: 0, y: 40, scale: 0.8 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "back.out(2)" }, 42.2);

      window.__timelines["main"] = tl;
    </script>
  </body>
