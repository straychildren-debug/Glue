# Godot generated cache
.godot/

# Local secrets
.env
.env.*
!.env.example

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini


# Local Godot editor binary (not versioned)
tools/godot/

# Local builds
build/

# Blender backup copies
*.blend1

# Python cache (Blender scripts)
__pycache__/

# Local preview server for index.html (machine-specific paths)
.claude/launch.json

# Scratch: maps, shots, local tools (node_modules, ffmpeg)
tmp/
tests/tmp/

# Cartoon project: rendered videos, snapshots and scratch (rebuilt from sources)
video/**/renders/
video/**/snapshots/
video/**/tmp/
video/**/node_modules/
video/**/*.mp4
